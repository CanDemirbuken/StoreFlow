@{
    Layout = "_Layout";
    ViewBag.Title = "Dashboard";
}

@await Component.InvokeAsync("DashboardIndexCardStatistics")
@await Component.InvokeAsync("DashboardIndexChart")

<div class="row">
    @await Component.InvokeAsync("DashboardIndexSalesStatus")
    @await Component.InvokeAsync("DashboardIndexActivity")
    @await Component.InvokeAsync("DashboardIndexDailySales")
</div>

@await Component.InvokeAsync("DashboardIndexInbox")

<div class="row">
    @await Component.InvokeAsync("DashboardIndexSalesData")
</div>
<div class="row">
    @await Component.InvokeAsync("DashboardIndexTodo")

    @await Component.InvokeAsync("DashboardIndexProducts")
</div>