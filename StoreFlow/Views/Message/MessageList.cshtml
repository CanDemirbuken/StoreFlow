@model List<Message>

@{
    Layout = "_Layout";
    ViewBag.Title = "Mesajlar";
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Mesaj Listesi</h3>
                <p class="card-description">
                    <code>Mesajlar ile ilgili işlemlerinizi buradan yapabilirsiniz.</code>
                </p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Gönderen</th>
                                <th>Konu</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                                <th>Mesajı Aç</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(++count)</td>
                                    <td>@item.Sender</td>
                                    <td>@item.Title</td>
                                    <td>@item.IsRead</td>
                                    <td>@item.DateTime</td>
                                    <td><a href="@Url.Action("DeleteMessage", "Message", new { id = item.Id })" class="btn btn-outline-danger">Sil</a></td>
                                    <td><a href="@Url.Action("UpdateMessage", "Message", new { id = item.Id })" class="btn btn-outline-warning">Güncelle</a></td>
                                    <td><a href="@Url.Action("ViewMessage", "Message", new { id = item.Id })" class="btn btn-outline-info">Mesajı Aç</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="@Url.Action("CreateMessage", "Message")" class="btn btn-outline-primary">Yeni Mesaj Ekle</a>
                </div>
            </div>
        </div>
    </div>
</div>